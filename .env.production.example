# =======================================================
# LeafTrack - Production Environment (bare-metal Ubuntu)
# Copy to .env.production and fill in actual values.
# NEVER commit .env.production to version control.
# =======================================================

# --- Supabase (self-hosted) ---
# IMPORTANT: Use port 54321 (Kong API gateway), NOT 5432 (raw Postgres)
# Get keys from: http://<server-ip>:54323 (Supabase Studio) > Settings > API
NEXT_PUBLIC_SUPABASE_URL=http://YOUR_TAILSCALE_IP:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-from-studio
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-from-studio

# --- Authentication (custom JWT) ---
# Generate with: openssl rand -base64 64
JWT_SECRET=your-64-char-random-string

# Generate with: openssl rand -base64 64
JWT_REFRESH_SECRET=your-different-64-char-random-string

# --- Application ---
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_APP_URL=https://sohagtea.in
NEXTAUTH_URL=https://sohagtea.in

# --- PDF Generation ---
# Install on server: sudo apt install -y chromium-browser
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
