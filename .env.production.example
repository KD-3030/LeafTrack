# Production Environment Configuration
# Copy this to .env.production and fill in your actual values
# NEVER commit .env.production to version control

# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/leaftrack-prod?retryWrites=true&w=majority&ssl=true&sslValidate=true
MONGODB_MAX_POOL_SIZE=50
MONGODB_SERVER_SELECTION_TIMEOUT=10000
MONGODB_SOCKET_TIMEOUT=45000

# Authentication Secrets (Generate using: openssl rand -base64 64)
JWT_SECRET=your-64-character-random-string-here
JWT_REFRESH_SECRET=different-64-character-random-string-here
NEXTAUTH_SECRET=another-32-character-random-string-here

# Application URLs
NEXTAUTH_URL=https://yourdomain.com
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Environment
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Security Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
STRICT_RATE_LIMIT_MAX=5
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Session Configuration
SESSION_TIMEOUT_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=7
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION_MINUTES=30

# Redis Configuration (for production rate limiting and sessions)
REDIS_URL=redis://username:password@localhost:6379/0
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=1000

# Monitoring and Logging
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
LOG_LEVEL=error
ENABLE_PERFORMANCE_MONITORING=true

# Email Configuration (for password reset, notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
EMAIL_FROM=noreply@yourdomain.com

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=leaftrack-backups
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# Performance Configuration
ENABLE_CACHE=true
CACHE_TTL_SECONDS=300
MAX_QUERY_EXECUTION_TIME=5000
ENABLE_QUERY_LOGGING=false

# Feature Flags
ENABLE_LOCATION_TRACKING=true
ENABLE_INVOICE_GENERATION=true
ENABLE_FINANCIAL_REPORTS=true
MAINTENANCE_MODE=false

# Third-party Services
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
OPENCAGE_API_KEY=your-opencage-api-key
PDF_SERVICE_URL=https://pdf-service.yourdomain.com

# Company Configuration (Override database defaults)
COMPANY_NAME=SohagTea
COMPANY_GST=your-gst-number
COMPANY_ADDRESS=your-company-address
COMPANY_PHONE=+91-XXXXXXXXXX
COMPANY_EMAIL=info@yourdomain.com
